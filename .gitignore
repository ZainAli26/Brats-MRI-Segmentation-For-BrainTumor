# =============================================================================
# BraTS MRI Segmentation — .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# DATASETS — NIfTI MRI data (multi-GB). Never commit raw data to git.
# Restore by downloading from Synapse.
# -----------------------------------------------------------------------------
Brats2024/
Brats2023/
# On rented boxes these are SYMLINKS to the data volume (/data/Brats2024). A pattern with
# a trailing slash does not match a symlink, so it would show up as an untracked file and
# could be committed as a machine-specific dangling link. Match it slash-less too.
Brats2024
Brats2023
MICCAI_BraTS_2019_Data_Training/
# Raw dataset archives (tens of GB) — download from Synapse, never commit.
*.zip
*.nii
*.nii.gz
*.mgz
*.mgh

# -----------------------------------------------------------------------------
# nnU-Net NATIVE DATA — generated by convert_to_nnunet.py (symlinks + remapped labels)
# -----------------------------------------------------------------------------
brats-segmentation/nnunet_data/
brats-segmentation/nnunet_data
brats-segmentation/.cache/
brats-segmentation/.cache

# -----------------------------------------------------------------------------
# TRAINING RUNS — checkpoints, logs, metrics, visualizations
# Reproducible by re-running training; can be very large.
# -----------------------------------------------------------------------------
brats-segmentation/runs/

# -----------------------------------------------------------------------------
# GENERATED OUTPUTS — all files in output/ are fully reproducible by running
# the agent scripts.  PNGs and CSVs can be large and change every run.
# Exception: track output/.gitkeep so the empty directory exists on clone.
# -----------------------------------------------------------------------------
brats-data-analysis/output/*
!brats-data-analysis/output/.gitkeep

# -----------------------------------------------------------------------------
# VISUALIZATIONS & EVAL OUTPUTS — generated by visualize_segmentations.py,
# export_3d_html.py, and evaluate_kfold.py. Large PNG/HTML renders, reproducible.
# -----------------------------------------------------------------------------
brats-segmentation/visualizations/
brats-segmentation/visualizations_3d/
brats-segmentation/visualizations_test/
brats-segmentation/eval_exp18_fold0/
brats-segmentation/eval_*/


# -----------------------------------------------------------------------------
# PYTHON VIRTUAL ENVIRONMENT — 357 MB, machine-specific.
# Recreate with: python3.12 -m venv .venv && pip install -r requirements.txt
# -----------------------------------------------------------------------------
.venv/
venv/
env/
ENV/


# -----------------------------------------------------------------------------
# PYTHON BYTECODE & CACHES
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/


# -----------------------------------------------------------------------------
# PYTHON PACKAGING ARTIFACTS (if the project is ever packaged)
# -----------------------------------------------------------------------------
*.egg-info/
dist/
build/
*.egg
MANIFEST
pip-wheel-metadata/
.eggs/


# -----------------------------------------------------------------------------
# CLAUDE CODE — session state, plans, and memory are local-only
# -----------------------------------------------------------------------------
.claude/


# -----------------------------------------------------------------------------
# MACOS SYSTEM FILES
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Icon?


# -----------------------------------------------------------------------------
# EDITORS & IDEs
# -----------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.ropeproject/


# -----------------------------------------------------------------------------
# JUPYTER (if notebooks are added later)
# -----------------------------------------------------------------------------
.ipynb_checkpoints/
*.ipynb_checkpoints


# -----------------------------------------------------------------------------
# LOGS & TEMP FILES
# -----------------------------------------------------------------------------
*.log
*.tmp
*.bak
*.orig

# Stray shell-redirect output file (e.g. `docker-compose run ... > out`)
brats-segmentation/out
